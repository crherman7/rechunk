{
  "name": "@rechunk/rollup-preset",
  "description": "Rollup configuration preset for bundling ReChunk components and modules",
  "version": "0.1.3",
  "author": "Chris Herman",
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@rechunk/utils": "workspace:*",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "merge-anything": "^6.0.2",
    "rollup": "^4.13.0",
    "rollup-plugin-tsconfig-paths": "1.5.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "typescript": "^5.4.3"
  },
  "keywords": [
    "build-tools",
    "bundler",
    "configuration",
    "optimization",
    "preset",
    "rechunk",
    "rollup"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "types": "dist/index.d.ts"
